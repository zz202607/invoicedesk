# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller one-dir build for the desktop workbench.

The UI is bundled as data under ``app/ui`` so ``runtime.resource_path`` finds it
inside ``_internal``. The EXE is windowed (no console); startup failures are
shown as dialogs and written to the local log instead.

Build it through ``python tools/build_app.py``, which also generates the icon
and runs the frozen ``--smoke`` check.
"""

from pathlib import Path

from PyInstaller.utils.hooks import collect_data_files

ROOT = Path(SPECPATH).resolve()
ICON = ROOT / "build" / "icon.ico"
# Generated by tools/make_version.py from pyproject.toml; optional so a plain
# `pyinstaller InvoiceDesk.spec` still builds a usable (but unversioned) EXE.
VERSION_FILE = ROOT / "build" / "version_info.txt"
# RapidOCR ships its ONNX models and keys inside the package; the OCR path is
# useless without them, so bundle the data next to the modules.
OCR_DATAS = collect_data_files("rapidocr_onnxruntime")

a = Analysis(
    [str(ROOT / "run.py")],
    pathex=[str(ROOT)],
    binaries=[],
    datas=[(str(ROOT / "app" / "ui"), "app/ui"), *OCR_DATAS],
    hiddenimports=[
        "webview.platforms.winforms",
        "webview.platforms.edgechromium",
        "clr",
        "rapidocr_onnxruntime",
        "onnxruntime",
        "cv2",
        "yaml",
        "shapely",
        "pyclipper",
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=["pytest", "pandas", "matplotlib", "tkinter", "PyQt5", "PySide6"],
    noarchive=False,
)

# OCR needs image decoding and inference, not video codecs or AVIF/WebP plugins.
# Dropping these binaries saves ~37 MB; the frozen smoke test still runs OCR.
_DROP = ("opencv_videoio_ffmpeg", "pil/_avif", "pil/_webp")
a.binaries = [
    item for item in a.binaries if not any(token in item[0].lower() for token in _DROP)
]
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="InvoiceDesk",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=str(ICON) if ICON.is_file() else None,
    version=str(VERSION_FILE) if VERSION_FILE.is_file() else None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="InvoiceDesk",
)
